rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── NOTES STORAGE ────────────────────────────────────────────────────
    // Users can only upload to their own folder: /notes/{userId}/...
    // Max file size: 20MB (PDF chapters, scanned images)
    match /notes/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/.*'));
    }

    // ─── AVATARS STORAGE ──────────────────────────────────────────────────
    // If users upload custom avatars (future feature)
    // Max 2MB, images only
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ─── OFFICIAL RELEASES (PUBLIC READ ONLY, WRITE VIA ADMIN / DEPLOY) ──
    // Public download for verified release artifacts (e.g. releases/android/quovex-1.0.0.apk)
    // Write/Upload is restricted to Admin SDK / Firebase CLI console only
    match /releases/{platform}/{fileName} {
      allow read: if true;
      allow write: if false; // Upload via Admin SDK / deployment tooling only
    }

    // ─── BLOCK EVERYTHING ELSE ────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
