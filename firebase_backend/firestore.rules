rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USERS ────────────────────────────────────────────────────────────
    // A user can read/write only their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sessions subcollection — own data only
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Flashcard decks subcollection — own data only
      match /flashcard_decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Friends list — own data only
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── NOTES ────────────────────────────────────────────────────────────
    // Notes are keyed by noteId but contain a userId field
    // A user can only access notes where userId == their uid
    match /notes/{noteId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid)
        && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ─── STUDY PLANS ──────────────────────────────────────────────────────
    match /study_plans/{planId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid)
        && (request.resource == null || request.resource.data.userId == request.auth.uid);

      match /tasks/{taskId} {
        allow read, write: if request.auth != null;
      }
    }

    // ─── STUDY ROOMS ──────────────────────────────────────────────────────
    match /study_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || resource.data.createdBy == "system");

      match /participants/{participantId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == participantId;
      }
    }

    // ─── LEADERBOARD ──────────────────────────────────────────────────────
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // ─── CONFIG (ADMIN ONLY) ──────────────────────────────────────────────
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if false; // Only Admin SDK via Cloud Functions
    }

    // ─── QUOVEX ORIGINALS (PHASE 8 PUBLIC CONTRACT) ───────────────────────
    // Public / Android clients can read ONLY published books
    // All writes/mutations MUST go through Firebase Admin SDK
    match /quovex_originals/{bookId} {
      allow read: if resource.data.approvalStatus == 'PUBLISHED';
      allow write: if false; // Managed exclusively by Server-Side Admin Control Plane
    }

    // ─── CONTENT STUDIO INTERNAL COLLECTIONS (ADMIN SDK EXCLUSIVE) ─────────
    // Public/Student clients CANNOT read or write draft books, generation jobs,
    // demand signals, evidence packs, debate blueprints, or validation reports.
    match /topic_demand_signals/{signalId} {
      allow read, write: if false;
    }

    match /book_requests/{requestId} {
      allow read, write: if false;
    }

    match /content_generation_jobs/{jobId} {
      allow read, write: if false;
    }

    match /evidence_packs/{packId} {
      allow read, write: if false;
    }

    match /editorial_blueprints/{blueprintId} {
      allow read, write: if false;
    }

    match /validation_reports/{reportId} {
      allow read, write: if false;
    }

    // ─── PHASE 9 ADMIN CONTROL CENTER COLLECTIONS (ADMIN SDK EXCLUSIVE) ───
    match /feature_flags/{flagId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Admin SDK
    }

    match /audit_logs/{logId} {
      allow read, write: if false; // Append-only via Admin SDK
    }

    match /moderation_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Triaged via Admin SDK
    }

    match /notification_campaigns/{campaignId} {
      allow read, write: if false; // Admin SDK exclusive
    }
  }
}

