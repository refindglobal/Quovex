# Quovex Admin — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# DO NOT commit .env.local containing real credentials.

# Google Cloud / Firebase Project Configuration
GOOGLE_CLOUD_PROJECT=quovex-f3104
FIREBASE_PROJECT_ID=quovex-f3104

# AI Model Providers (Used for Content Studio Multi-Agent Generation)
GROQ_API_KEY=
