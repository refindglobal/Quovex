# ==============================================================================
# Quovex Production Environment Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env or .env.local in respective deployment environments.
# NEVER commit real secret values, production API keys, or private certificates.
# ==============================================================================

# --- Firebase Admin SDK & Cloud Backend ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# --- Next.js Admin Control Center ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=
ADMIN_MASTER_SECRET=
ADMIN_INITIAL_EMAIL=
NODE_ENV=production

# --- Groq AI 4-Key Rotation Pool ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# --- Cerebras AI 4-Key Rotation Pool ---
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=

# --- Android Client Secrets (secrets.properties) ---
GOOGLE_WEB_CLIENT_ID=

# --- Firebase Cloud Messaging (Push Notifications) ---
FCM_SERVER_KEY=

# --- Google Play Billing v6 ---
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.quovex
